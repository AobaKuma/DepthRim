<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    水中內爆的粒子（Docs/水中內爆_實作計畫.md §4.3）。貼圖都是白色，顏色由程式依水深層級與燙傷型用 instanceColor 給。
    renderQueue 3185：畫在水層（艙室 2950、外海 3177）之上，但顏色由程式依該處的水色與混濁度混過去，看起來是在水裡面
    （2026-11-18 試過直接排在水層下面：夜裡外海層幾乎不透明，整個內爆都看不見）。迷霧格中心的內爆不畫。
  -->

  <!-- 0 秒的閃光：比原版爆炸閃光小、短 -->
  <FleckDef ParentName="FleckBase">
    <defName>DepthRim_ImplosionFlash</defName>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <fadeInTime>0</fadeInTime>
    <solidTime>0.03</solidTime>
    <fadeOutTime>0.12</fadeOutTime>
    <graphicData>
      <texPath>Things/Mote/ExplosionFlash</texPath>
      <shaderType>MoteGlow</shaderType>
      <renderQueue>3185</renderQueue>
    </graphicData>
  </FleckDef>

  <!--
    空間扭曲（2026-11-18 使用者要求「原版靈能的那種扭曲效果」）：原版 Core 的 MoteLargeDistortionWave 著色器與貼圖
    （ShockwaveFast、靈能收縮環用的同一套），不依賴 DLC。著色器換成複本 DepthRim_ImplosionWarp（Implosion_Shader.xml）：
    原版在 3151 抓畫面、會被外海層蓋掉，複本改在 3188 抓，扭曲的是看得見的水與內爆。
    向外：爆炸瞬間的壓力波；向內：氣泡塌回中心時，周圍的水被吸進去。
  -->
  <FleckDef ParentName="FleckBase">
    <defName>DepthRim_ImplosionWarpOut</defName>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <fadeInTime>0</fadeInTime>
    <solidTime>0.05</solidTime>
    <fadeOutTime>0.35</fadeOutTime>
    <growthRate>16</growthRate>
    <graphicData>
      <graphicClass>Graphic_FleckPulse</graphicClass>
      <texPath>Things/Mote/Black</texPath>
      <shaderType>DepthRim_ImplosionWarp</shaderType>
      <shaderParameters>
        <_DistortionTex>/Things/Mote/PsychicDistortionCurrents</_DistortionTex>
        <_NoiseTex>/Things/Mote/PsycastNoise</_NoiseTex>
        <_distortionIntensity>0.08</_distortionIntensity>
        <_brightnessMultiplier>1.2</_brightnessMultiplier>
      </shaderParameters>
      <drawSize>1.0</drawSize>
    </graphicData>
  </FleckDef>

  <FleckDef ParentName="FleckBase">
    <defName>DepthRim_ImplosionWarpIn</defName>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <fadeInTime>0.05</fadeInTime>
    <solidTime>0.05</solidTime>
    <fadeOutTime>0.2</fadeOutTime>
    <growthRate>-14</growthRate>
    <graphicData>
      <graphicClass>Graphic_FleckPulse</graphicClass>
      <texPath>Things/Mote/Black</texPath>
      <shaderType>DepthRim_ImplosionWarp</shaderType>
      <shaderParameters>
        <_DistortionTex>/Things/Mote/PsychicDistortionCurrents</_DistortionTex>
        <_NoiseTex>/Things/Mote/PsycastNoise</_NoiseTex>
        <_distortionIntensity>0.1</_distortionIntensity>
        <_brightnessMultiplier>-0.2</_brightnessMultiplier>
      </shaderParameters>
      <drawSize>1.0</drawSize>
    </graphicData>
  </FleckDef>

  <!-- 每格往中心吸的小氣泡：飛行時間由程式設定（到崩塌時剛好抵達中心） -->
  <FleckDef ParentName="FleckBase_RandomGraphic_Thrown">
    <defName>DepthRim_ImplosionInward</defName>
    <randomGraphics>
      <li>
        <graphicClass>Graphic_Fleck</graphicClass>
        <texPath>DepthRim/Implosion/BubbleSmall_A</texPath>
        <shaderType>TransparentPostLight</shaderType>
        <renderQueue>3185</renderQueue>
      </li>
      <li>
        <graphicClass>Graphic_Fleck</graphicClass>
        <texPath>DepthRim/Implosion/BubbleSmall_B</texPath>
        <shaderType>TransparentPostLight</shaderType>
        <renderQueue>3185</renderQueue>
      </li>
      <li>
        <graphicClass>Graphic_Fleck</graphicClass>
        <texPath>DepthRim/Implosion/BubbleSmall_C</texPath>
        <shaderType>TransparentPostLight</shaderType>
        <renderQueue>3185</renderQueue>
      </li>
    </randomGraphics>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <fadeInTime>0.04</fadeInTime>
    <solidTime>0.3</solidTime>
    <fadeOutTime>0.12</fadeOutTime>
    <growthRate>-0.15</growthRate>
  </FleckDef>

  <!-- 崩塌後上升的氣泡柱：往畫面上方漂、邊漂邊變大 -->
  <FleckDef ParentName="FleckBase_RandomGraphic_Thrown">
    <defName>DepthRim_ImplosionBubble</defName>
    <randomGraphics>
      <li>
        <graphicClass>Graphic_Fleck</graphicClass>
        <texPath>DepthRim/Implosion/BubbleSmall_A</texPath>
        <shaderType>TransparentPostLight</shaderType>
        <renderQueue>3185</renderQueue>
      </li>
      <li>
        <graphicClass>Graphic_Fleck</graphicClass>
        <texPath>DepthRim/Implosion/BubbleSmall_B</texPath>
        <shaderType>TransparentPostLight</shaderType>
        <renderQueue>3185</renderQueue>
      </li>
      <li>
        <graphicClass>Graphic_Fleck</graphicClass>
        <texPath>DepthRim/Implosion/BubbleSmall_C</texPath>
        <shaderType>TransparentPostLight</shaderType>
        <renderQueue>3185</renderQueue>
      </li>
    </randomGraphics>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <fadeInTime>0.1</fadeInTime>
    <solidTime>0.7</solidTime>
    <fadeOutTime>0.6</fadeOutTime>
    <growthRate>0.08</growthRate>
  </FleckDef>

  <!-- 混濁水團：崩塌時揚起的水渦／沉積物，很慢地散開（燙傷型是偏白的蒸氣色） -->
  <FleckDef ParentName="FleckBase_Thrown">
    <defName>DepthRim_ImplosionMurk</defName>
    <graphicData>
      <texPath>Things/Mote/Smoke</texPath>
      <shaderType>TransparentPostLight</shaderType>
      <renderQueue>3184</renderQueue>
      <renderInstanced>true</renderInstanced>
    </graphicData>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <fadeInTime>0.3</fadeInTime>
    <solidTime>1.2</solidTime>
    <fadeOutTime>2.4</fadeOutTime>
    <growthRate>0.35</growthRate>
  </FleckDef>

</Defs>
