<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    海面地圖：地表圖層海洋格上的地圖。海不是原版深水地形，而是類似虛空的 DepthRim_OpenSea
    （dontRender、不可通行），看到的海面是背景層 DepthRim.SectionLayer_SeaSurface 畫的（queue 1900，在地形 2000 之前）。
    玩家站在海上平台（DepthRim_OceanPlatform）上；平台下方的支柱（DepthRim_PlatformPillar）也是背景的一部分：
    著色器 DepthRim_Background（queue 1950）排在海面之後、地形之前，所以支柱蓋在海上、被平台與平台側面擋住。
  -->

  <TerrainAffordanceDef>
    <defName>DepthRim_OpenSea</defName>
    <label>open sea</label>
    <order>2440</order>
  </TerrainAffordanceDef>

  <!-- 平台層的高空：海上平台只能鋪在這裡 -->
  <TerrainAffordanceDef>
    <defName>DepthRim_OpenAir</defName>
    <label>open air</label>
    <order>2445</order>
  </TerrainAffordanceDef>

  <!-- 只有海上平台提供（目前沒有建築需要它；舊版的支柱基座蓋在這上面） -->
  <TerrainAffordanceDef>
    <defName>DepthRim_OceanDeck</defName>
    <label>ocean platform</label>
    <order>2450</order>
  </TerrainAffordanceDef>

  <TerrainDef>
    <defName>DepthRim_OpenSea</defName>
    <label>open sea</label>
    <description>Open ocean. Nothing can stand on the water; platforms, pillars and bridges can be built over it.</description>
    <dontRender>true</dontRender>
    <color>(0.08, 0.22, 0.32)</color>
    <fertility>0</fertility>
    <passability>Impassable</passability>
    <natural>true</natural>
    <holdSnowOrSand>false</holdSnowOrSand>
    <avoidWander>true</avoidWander>
    <!-- 雷擊打在海上不會留下火（2026-11-17：暴風雨中的惡劣海況） -->
    <extinguishesFire>true</extinguishesFire>
    <!-- Bridgeable：可以蓋原版的橋與重型橋（地基層，TerrainAt 回傳橋，所以那一格不再算開放海面）。
         龍骨樁的 allowedTerrains 看的是 BaseTerrainAt（開放海面），所以船旁邊的橋不會被當成船體帶走。
         橋被拆掉或炸毀時，上面的東西照 DepthRim.Patch_FoundationRemovedOverSea 處理。 -->
    <affordances>
      <li>DepthRim_OpenSea</li>
      <li>DepthRim_OpenWater</li>
      <li>DepthRim_HullBase</li>
      <li>Bridgeable</li>
    </affordances>
    <tags>
      <li>DepthRim_OpenSea</li>
    </tags>
  </TerrainDef>

  <!-- 平台層的高空：看下去是海（SectionLayer_SeaSurface 照樣畫，往南偏 SeaDropCells 格），本身不畫、不可通行。 -->
  <TerrainDef>
    <defName>DepthRim_OpenAir</defName>
    <label>open air</label>
    <description>Empty air high above the sea. Ocean platform can be laid here within reach of a platform pillar.</description>
    <dontRender>true</dontRender>
    <color>(0.08, 0.22, 0.32)</color>
    <fertility>0</fertility>
    <passability>Impassable</passability>
    <natural>true</natural>
    <holdSnowOrSand>false</holdSnowOrSand>
    <avoidWander>true</avoidWander>
    <affordances>
      <li>DepthRim_OpenAir</li>
    </affordances>
  </TerrainDef>

  <!-- 海上平台：比照船體平台（邊框與側面由 SectionLayer_HullPlatformProps 畫），只能鋪在開放海面上。
       拆除沿用 DMSE 的「拆除平台」；地表圖層沒有 TransferEnvironmentExtension，DMSE 會改成太空，
       DepthRim.Patch_SeaSurfaceVoid 在海面地圖上把太空換回開放海面。 -->
  <TerrainDef>
    <defName>DepthRim_OceanPlatform</defName>
    <researchPrerequisites>
      <li>DepthRim_PressureEngineering</li>
    </researchPrerequisites>
    <label>ocean platform</label>
    <description>A steel deck raised high above the waves on pillars. Anything can be built on it. It can only be laid on the platform level, within the support radius of a platform pillar, and collapses into the sea if it loses that support.\n\nIt can be taken apart with the 'remove platform' command, leaving open air.</description>
    <texturePath>Thing/DR_OceanPlatform/Platform</texturePath>
    <renderPrecedence>241</renderPrecedence>
    <preventCraters>true</preventCraters>
    <layerable>false</layerable>
    <fertility>0</fertility>
    <canEverTerraform>false</canEverTerraform>
    <natural>true</natural>
    <edgeType>Hard</edgeType>
    <constructEffect>ConstructMetal</constructEffect>
    <designationCategory>DepthRim_Underwater</designationCategory>
    <uiOrder>1020</uiOrder>
    <costList>
      <Steel>15</Steel>
    </costList>
    <statBases>
      <WorkToBuild>3000</WorkToBuild>
      <MarketValue>0</MarketValue>
      <Beauty>-2</Beauty>
      <Flammability>0</Flammability>
    </statBases>
    <filthAcceptanceMask>
      <li>Unnatural</li>
    </filthAcceptanceMask>
    <affordances>
      <li>Light</li>
      <li>Medium</li>
      <li>Heavy</li>
      <li>Walkable</li>
      <li>DepthRim_OceanDeck</li>
    </affordances>
    <terrainAffordanceNeeded>DepthRim_OpenAir</terrainAffordanceNeeded>
    <!-- 只能鋪在平台層、平台支柱的支撐範圍內 -->
    <placeWorkers>
      <li>DepthRim.PlaceWorker_PlatformSupported</li>
    </placeWorkers>
    <modExtensions>
      <li Class="DepthRim.HullPlatformPropsExtension">
        <oShapeTexPath>Thing/DR_OceanPlatform/BorderInside_OShape</oShapeTexPath>
        <uShapeTexPath>Thing/DR_OceanPlatform/BorderInside_UShape</uShapeTexPath>
        <cornerInnerTexPath>Thing/DR_OceanPlatform/BorderInside_CornerInner</cornerInnerTexPath>
        <cornerOuterTexPath>Thing/DR_OceanPlatform/BorderInside_CornerOuter</cornerOuterTexPath>
        <flatTexPath>Thing/DR_OceanPlatform/BorderInside_Flat</flatTexPath>
        <sideLeftTexPath>Thing/DR_OceanPlatform/Edge_Left</sideLeftTexPath>
        <sideRightTexPath>Thing/DR_OceanPlatform/Edge_Right</sideRightTexPath>
        <sideSingleTexPath>Thing/DR_OceanPlatform/Single</sideSingleTexPath>
        <sideLoopTexPaths>
          <li>Thing/DR_OceanPlatform/Edge_Loop</li>
        </sideLoopTexPaths>
      </li>
      <li Class="Fortified.RemovablePlatformExtension">
        <refundFraction>0.5</refundFraction>
      </li>
    </modExtensions>
  </TerrainDef>

  <!-- 平台支柱（DepthRim.Building_PillarFoot）：蓋在水面層的開放海面上（9×9；平台層的支柱頂是 3×3），是上下兩層之間的升降梯。
       - 蓋好時建立平台層（第一根），並在平台層同一位置開出 5×5 的海上平台、放支柱頂（DepthRim_PlatformPillarTop）。
       - 水面層看到的柱身從入水處往上伸（SectionLayer_PlatformPillars，背景著色器）；本身不畫（drawerType None）。
       - 支撐半徑 18 格（圓形，在平台層算）：範圍內才能鋪海上平台；支柱拆掉後，範圍外的平台倒數 15 秒崩塌。
       - 柱身貼圖的入水處（混凝土基座中段）在支柱中心往南 14.1 格 = 平台離海面的高度（MapComponent_SeaSurface.SeaDropCells）。 -->
  <ThingDef ParentName="BuildingBase">
    <defName>DepthRim_PlatformPillar</defName>
    <researchPrerequisites>
      <li>DepthRim_PressureEngineering</li>
    </researchPrerequisites>
    <thingClass>DepthRim.Building_PillarFoot</thingClass>
    <label>platform pillar</label>
    <description>A massive steel-and-concrete pillar driven into the seabed, rising high above the waves. When it is finished, a small ocean platform opens on top of it; the pillar holds up any ocean platform within its support radius, and platform left without any pillar in range collapses into the sea.

      An elevator inside the pillar links the water below with the platform above. Build it on open sea right next to a floating platform: at least one side of its 9x9 footprint must touch it, and that cell (outlined green while placing) is the elevator spot.</description>
    <graphicData>
      <!-- 藍圖與圖示用；蓋好後不畫（柱身由背景層畫） -->
      <texPath>Thing/DR_PlatformPillarBase</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(3,3)</drawSize>
    </graphicData>
    <drawerType>None</drawerType>
    <uiIconPath>Thing/DR_PlatformPillarBase</uiIconPath>
    <size>(9,9)</size>
    <!-- 升降點：9×9 四邊外側緊貼的任一格浮船（Building_PillarFoot.LandingCell，正南中間優先）；至少要有一格（PlaceWorker_PillarFoot） -->
    <rotatable>false</rotatable>
    <altitudeLayer>Building</altitudeLayer>
    <!-- 地形是開放海面（不可通行），原版尋路不看建築，所以支柱腳本身站不上去；Pawn 從升降點上下 -->
    <passability>Standable</passability>
    <canOverlapZones>false</canOverlapZones>
    <tickerType>Normal</tickerType>
    <terrainAffordanceNeeded>DepthRim_OpenSea</terrainAffordanceNeeded>
    <designationCategory>DepthRim_Underwater</designationCategory>
    <uiOrder>1021</uiOrder>
    <statBases>
      <MaxHitPoints>1500</MaxHitPoints>
      <WorkToBuild>8000</WorkToBuild>
      <Beauty>0</Beauty>
      <Flammability>0</Flammability>
    </statBases>
    <costList>
      <Steel>200</Steel>
    </costList>
    <placeWorkers>
      <li>DepthRim.PlaceWorker_PillarRange</li>
      <!-- 上下檢查：水面層要緊貼浮船（升降點），平台層支柱頂（3×3）的位置不能有建築 -->
      <li>DepthRim.PlaceWorker_PillarFoot</li>
    </placeWorkers>
    <building>
      <isEdifice>true</isEdifice>
      <ai_chillDestination>false</ai_chillDestination>
    </building>
    <!-- 跨層電力（M5.5，CompCrossLayerPower）：支柱腳把水面層電網的剩餘電力送上平台層（預設往上送，gizmo 可切換方向；最多 2000 W、線損 5%）。
         兩端都是原版 CompPowerTrader（耗電 0，輸出由橋接每 15 ticks 改）；兩端都 transmitsPower（本身就是導線節點，旁邊的電線／建築直接接上）。 -->
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>0</basePowerConsumption>
        <shortCircuitInRain>false</shortCircuitInRain>
        <showPowerNeededIfOff>false</showPowerNeededIfOff>
        <transmitsPower>true</transmitsPower>
      </li>
      <li Class="DepthRim.CompProperties_CrossLayerPower">
        <capacity>2000</capacity>
        <lineLoss>0.05</lineLoss>
      </li>
    </comps>
    <portal>
      <pocketMapGenerator>DepthRim_PlatformLevel</pocketMapGenerator>
      <exitDef>DepthRim_PlatformPillarTop</exitDef>
    </portal>
    <modExtensions>
      <li Class="DepthRim.PlatformPillarExtension">
        <pillarTexPath>Thing/DR_PlatformPillar</pillarTexPath>
        <pillarDrawSize>(11,18.333)</pillarDrawSize>
        <pillarOffsetZ>-10</pillarOffsetZ>
        <supportRadius>27.9</supportRadius>
        <waterlineWidth>9</waterlineWidth>
      </li>
    </modExtensions>
  </ThingDef>

  <!-- 支柱頂（DepthRim.Building_PlatformPillar）：平台層甲板上的 3×3，由支柱自動生成、拆支柱時一起消失；是升降梯的上端。
       柱身由 SectionLayer_PlatformPillars 往下畫（背景著色器：海面之上、甲板與平台側面之下）。 -->
  <ThingDef ParentName="PocketMapExit">
    <defName>DepthRim_PlatformPillarTop</defName>
    <thingClass>DepthRim.Building_PlatformPillar</thingClass>
    <label>platform pillar top</label>
    <description>The top of a platform pillar, with the elevator down to the water.</description>
    <graphicData>
      <texPath>Thing/DR_PlatformPillarBase</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(5,5)</drawSize>
    </graphicData>
    <size>(3,3)</size>
    <rotatable>false</rotatable>
    <altitudeLayer>Building</altitudeLayer>
    <!-- 可以慢慢穿過（原版不允許「不可通行但能被射穿」的玩家建築）；半身掩體 -->
    <passability>PassThroughOnly</passability>
    <pathCost>60</pathCost>
    <fillPercent>0.5</fillPercent>
    <castEdgeShadows>true</castEdgeShadows>
    <staticSunShadowHeight>0.3</staticSunShadowHeight>
    <tickerType>Normal</tickerType>
    <useHitPoints>false</useHitPoints>
    <destroyable>true</destroyable>
    <selectable>true</selectable>
    <canOverlapZones>false</canOverlapZones>
    <statBases>
      <Flammability>0</Flammability>
    </statBases>
    <!-- 跨層電力（M5.5，CompCrossLayerPower）：支柱頂是收端，發電量 = 支柱腳送上來的電（預設往上送，gizmo 可切換方向；最多 2000 W、線損 5%）。
         兩端都是原版 CompPowerTrader（耗電 0，輸出由橋接每 15 ticks 改）；兩端都 transmitsPower（本身就是導線節點，旁邊的電線／建築直接接上）。 -->
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>0</basePowerConsumption>
        <shortCircuitInRain>false</shortCircuitInRain>
        <showPowerNeededIfOff>false</showPowerNeededIfOff>
        <transmitsPower>true</transmitsPower>
      </li>
      <li Class="DepthRim.CompProperties_CrossLayerPower">
        <capacity>2000</capacity>
        <lineLoss>0.05</lineLoss>
      </li>
    </comps>
    <building>
      <isEdifice>true</isEdifice>
      <deconstructible>false</deconstructible>
      <isTargetable>false</isTargetable>
      <claimable>false</claimable>
      <expandHomeArea>false</expandHomeArea>
      <ai_chillDestination>false</ai_chillDestination>
    </building>
    <modExtensions>
      <li Class="DepthRim.PlatformPillarExtension">
        <pillarTexPath>Thing/DR_PlatformPillar</pillarTexPath>
        <pillarDrawSize>(11,18.333)</pillarDrawSize>
        <pillarOffsetZ>-10</pillarOffsetZ>
        <supportRadius>27.9</supportRadius>
        <waterlineWidth>9</waterlineWidth>
      </li>
    </modExtensions>
  </ThingDef>

  <!-- 平台層往下伸的柱身（DepthRim.SectionLayer_PlatformPillars）：排在海面（1900）、往下看的快照（1940）與平台影子（1945）之後、
       地形（2000）與平台側面之前。柱身依高度自己算平台的影子（DepthRim_Pillar.frag.glsl，要世界座標，所以用 DepthRim_Midwater.vert.glsl）。 -->
  <ShaderDef>
    <defName>DepthRim_Background</defName>
    <shaderProgram>
      <vertexShaderFileName>DepthRim_Midwater.vert.glsl</vertexShaderFileName>
      <fragmentShaderFileName>DepthRim_Pillar.frag.glsl</fragmentShaderFileName>
      <transparent>true</transparent>
      <depthTest>false</depthTest>
      <depthWrite>false</depthWrite>
      <renderQueue>1950</renderQueue>
      <textureWrapOverrides>
        <li>
          <key>_MainTex</key>
          <value>Clamp</value>
        </li>
        <li>
          <key>_MaskTex</key>
          <value>Clamp</value>
        </li>
      </textureWrapOverrides>
    </shaderProgram>
  </ShaderDef>

  <ShaderTypeDef>
    <defName>DepthRim_Background</defName>
    <shaderPath>Map/DepthRim_Background</shaderPath>
  </ShaderTypeDef>

  <!-- 平台層往下看的快照（SectionLayer_LowerLevel）：海面之後、支柱柱身之前 -->
  <ShaderDef>
    <defName>DepthRim_BackgroundLower</defName>
    <shaderProgram>
      <vertexShaderFileName>Transparent.vert.glsl</vertexShaderFileName>
      <fragmentShaderFileName>DepthRim_BackgroundLower.frag.glsl</fragmentShaderFileName>
      <transparent>true</transparent>
      <depthTest>false</depthTest>
      <depthWrite>false</depthWrite>
      <renderQueue>1940</renderQueue>
    </shaderProgram>
  </ShaderDef>

  <ShaderTypeDef>
    <defName>DepthRim_BackgroundLower</defName>
    <shaderPath>Map/DepthRim_BackgroundLower</shaderPath>
  </ShaderTypeDef>

  <!-- 平台底下的暗化層（DepthRim.SectionLayer_PlatformShadow）：天光遮蔽、陽光投影、柱影、頭上甲板的輪廓，蓋在平台底下的一切上。
       水面層：建築與 Pawn（2900）之後、往上伸的柱身（2910）之前（柱身依高度自己算影子）。 -->
  <ShaderDef>
    <defName>DepthRim_PlatformShadow</defName>
    <shaderProgram>
      <vertexShaderFileName>MapWorldUV.vert.glsl</vertexShaderFileName>
      <fragmentShaderFileName>DepthRim_PlatformShadow.frag.glsl</fragmentShaderFileName>
      <flipTextureST>false</flipTextureST>
      <transparent>true</transparent>
      <depthTest>false</depthTest>
      <depthWrite>false</depthWrite>
      <cullMode>None</cullMode>
      <renderQueue>2905</renderQueue>
      <textureWrapOverrides>
        <li>
          <key>_MaskTex</key>
          <value>Clamp</value>
        </li>
      </textureWrapOverrides>
    </shaderProgram>
  </ShaderDef>

  <ShaderTypeDef>
    <defName>DepthRim_PlatformShadow</defName>
    <shaderPath>Map/DepthRim_PlatformShadow</shaderPath>
  </ShaderTypeDef>

  <!-- 平台層往下看時的暗化層：往下看的快照（1940）之後、往下伸的柱身（1950，自己算影子）與平台甲板（2000）之前。 -->
  <ShaderDef>
    <defName>DepthRim_PlatformShadowLower</defName>
    <shaderProgram>
      <vertexShaderFileName>MapWorldUV.vert.glsl</vertexShaderFileName>
      <fragmentShaderFileName>DepthRim_PlatformShadow.frag.glsl</fragmentShaderFileName>
      <flipTextureST>false</flipTextureST>
      <transparent>true</transparent>
      <depthTest>false</depthTest>
      <depthWrite>false</depthWrite>
      <cullMode>None</cullMode>
      <renderQueue>1945</renderQueue>
      <textureWrapOverrides>
        <li>
          <key>_MaskTex</key>
          <value>Clamp</value>
        </li>
      </textureWrapOverrides>
    </shaderProgram>
  </ShaderDef>

  <ShaderTypeDef>
    <defName>DepthRim_PlatformShadowLower</defName>
    <shaderPath>Map/DepthRim_PlatformShadowLower</shaderPath>
  </ShaderTypeDef>

  <!-- 水面層往上伸的柱身：在浮船甲板、平台邊框、建築與 Pawn（2900）之後。柱身從入水處往北伸，
       所以只會蓋到柱子後面（北邊）的東西；柱子前面（南邊）的東西畫在入水處以南，碰不到柱身。
       和往下伸的柱身同一個著色器（依高度自己算平台的影子），只是排序不同。 -->
  <ShaderDef>
    <defName>DepthRim_PillarRaised</defName>
    <shaderProgram>
      <vertexShaderFileName>DepthRim_Midwater.vert.glsl</vertexShaderFileName>
      <fragmentShaderFileName>DepthRim_Pillar.frag.glsl</fragmentShaderFileName>
      <transparent>true</transparent>
      <depthTest>false</depthTest>
      <depthWrite>false</depthWrite>
      <renderQueue>2910</renderQueue>
      <textureWrapOverrides>
        <li>
          <key>_MainTex</key>
          <value>Clamp</value>
        </li>
        <li>
          <key>_MaskTex</key>
          <value>Clamp</value>
        </li>
      </textureWrapOverrides>
    </shaderProgram>
  </ShaderDef>

  <ShaderTypeDef>
    <defName>DepthRim_PillarRaised</defName>
    <shaderPath>Map/DepthRim_PillarRaised</shaderPath>
  </ShaderTypeDef>

  <!-- 海面背景著色器（DepthRim.SectionLayer_SeaSurface）：只畫在開放海面格，最先畫（1900），不做深度測試。
       海面在平台下方幾格：平台影子與支柱腳下的白沫用 MapComponent_SeaSurface 的遮罩（平台／支柱佔地）畫，往南偏移。 -->
  <ShaderDef>
    <defName>DepthRim_SeaSurface</defName>
    <shaderProgram>
      <vertexShaderFileName>MapWorldUV.vert.glsl</vertexShaderFileName>
      <fragmentShaderFileName>DepthRim_SeaSurface.frag.glsl</fragmentShaderFileName>
      <flipTextureST>false</flipTextureST>
      <transparent>false</transparent>
      <depthTest>false</depthTest>
      <depthWrite>false</depthWrite>
      <cullMode>None</cullMode>
      <renderQueue>1900</renderQueue>
      <textureWrapOverrides>
        <li>
          <key>_MaskTex</key>
          <value>Clamp</value>
        </li>
        <!-- 原版深海的貼圖：和原版 TerrainWater／WaterDepth 的著色器定義一樣設成重複（引擎預設是 Clamp，
             漣漪貼圖在地圖上鋪 15 次，不重複的話整片海只會取到貼圖邊緣，變成平的） -->
        <li>
          <key>_RampTex</key>
          <value>Repeat</value>
        </li>
        <li>
          <key>_RippleTex</key>
          <value>Repeat</value>
        </li>
        <li>
          <key>_WaterReflectionTex</key>
          <value>Repeat</value>
        </li>
        <li>
          <key>_NoiseTex</key>
          <value>Repeat</value>
        </li>
      </textureWrapOverrides>
    </shaderProgram>
  </ShaderDef>

  <ShaderTypeDef>
    <defName>DepthRim_SeaSurface</defName>
    <shaderPath>Map/DepthRim_SeaSurface</shaderPath>
  </ShaderTypeDef>

  <!-- 海面地點：地表圖層海洋格上的地圖父物件。有玩家建築或 Pawn 時保留地圖。 -->
  <WorldObjectDef>
    <defName>DepthRim_SeaSurfaceSite</defName>
    <label>sea platform</label>
    <description>A platform on the open sea.</description>
    <worldObjectClass>DepthRim.WorldObject_SeaSurfaceSite</worldObjectClass>
    <mapGenerator>DepthRim_SeaSurface</mapGenerator>
    <canBePlayerHome>true</canBePlayerHome>
    <useDynamicDrawer>true</useDynamicDrawer>
    <!-- 拉近時原版 WorldObject.Draw 畫的是 texture（沒設就什麼都不畫）；拉遠才換成 expandingIconTexture。 -->
    <texture>World/WorldObjects/Camp</texture>
    <expandingIcon>true</expandingIcon>
    <expandingIconTexture>World/WorldObjects/Expanding/Gravship</expandingIconTexture>
    <expandingIconPriority>60</expandingIconPriority>
    <expandingIconColor>(220,170,90,255)</expandingIconColor>
    <neverMultiSelect>true</neverMultiSelect>
    <inspectorTabs>
      <li>WITab_Terrain</li>
      <li>WITab_Planet</li>
    </inspectorTabs>
  </WorldObjectDef>

  <!-- 海面地圖（水面層）：整張鋪開放海面，一開始什麼都沒有。沒有迷霧（海面一覽無遺），不用原版 Fog／玩家起點。 -->
  <MapGeneratorDef>
    <defName>DepthRim_SeaSurface</defName>
    <label>sea surface</label>
    <disableCallAid>true</disableCallAid>
    <ignoreAreaRevealedLetter>true</ignoreAreaRevealedLetter>
    <genSteps>
      <li>DepthRim_SeaSurface</li>
    </genSteps>
  </MapGeneratorDef>

  <GenStepDef>
    <defName>DepthRim_SeaSurface</defName>
    <order>200</order>
    <genStep Class="DepthRim.GenStep_SeaSurface">
      <platformSize>(0,0)</platformSize>
    </genStep>
  </GenStepDef>

  <!-- 平台層：水面層的口袋地圖（同尺寸、座標對齊），由第一根支柱建立。整張是高空，平台由支柱開出。
       溫度跟水面層（DepthRim.Patch_PlatformLevelTemperature），口袋地圖的地點設在水面層的格子上，所以天空與日照一致。 -->
  <MapGeneratorDef>
    <defName>DepthRim_PlatformLevel</defName>
    <label>platform level</label>
    <isUnderground>false</isUnderground>
    <disableCallAid>true</disableCallAid>
    <ignoreAreaRevealedLetter>true</ignoreAreaRevealedLetter>
    <pocketMapProperties>
      <biome>Ocean</biome>
      <temperature>10</temperature>
    </pocketMapProperties>
    <genSteps>
      <li>DepthRim_PlatformLevel</li>
    </genSteps>
  </MapGeneratorDef>

  <GenStepDef>
    <defName>DepthRim_PlatformLevel</defName>
    <order>200</order>
    <genStep Class="DepthRim.GenStep_PlatformLevel" />
  </GenStepDef>

  <!-- 平台層的往下看快照（SectionLayer_LowerLevel）要重建 -->
  <MapMeshFlagDef>
    <defName>DepthRim_LowerLevel</defName>
  </MapMeshFlagDef>

</Defs>