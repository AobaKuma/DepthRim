  <PawnKindDef ParentName="AnimalKindBase">
    <defName>DepthRim_Fish_Large</defName>
    <label>large fish</label>
    <race>DepthRim_Fish_Large</race>
    <canArriveManhunter>false</canArriveManhunter>
    <combatPower>40</combatPower>
    <ecoSystemWeight>0.6</ecoSystemWeight>
    <wildGroupSize>1~2</wildGroupSize>
    <lifeStages>
      <li>
        <bodyGraphicData>
          <texPath>Thing/Fish/fish_l</texPath>
