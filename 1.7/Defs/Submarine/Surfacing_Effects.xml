<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    出水演出的水花（2026-11-15）：照原版生物出水（EffecterDef PawnEmergeFromWater / PawnEmergeFromWaterLarge）。
    下面是原版 GroundWaterSplash 的原樣複本（貼圖、顏色、時間、scaler 曲線都不動），
    改了兩處：scalingAnchor 改成中心（演出把水柱轉到船體法線方向，原版 (.5,.2) 的錨點補償只往北、不跟著旋轉，水柱的根會漂走；
    演出把生成點往法線推出去補回來），以及 renderQueue 3300：DMSE 過場的船體畫在 3200，原版 mote 材質在它下面，水柱才蓋得住船體浮現的邊緣。
  -->

  <FleckDef ParentName="FleckBase_RandomGraphic_Thrown">
    <defName>DepthRim_SurfacingSplash</defName>
    <randomGraphics>
      <li>
        <graphicClass>Graphic_FleckPulse</graphicClass>
        <shaderType>Mote</shaderType>
        <texPath>Things/Mote/GroundSplash/GroundSplashA</texPath>
        <drawSize>(1,1)</drawSize>
        <color>(0.53, 0.69, 0.74, .5)</color>
        <renderQueue>3300</renderQueue>
      </li>
      <li>
        <graphicClass>Graphic_FleckPulse</graphicClass>
        <shaderType>Mote</shaderType>
        <texPath>Things/Mote/GroundSplash/GroundSplashB</texPath>
        <drawSize>(1,1)</drawSize>
        <color>(0.53, 0.69, 0.74, .5)</color>
        <renderQueue>3300</renderQueue>
      </li>
    </randomGraphics>
    <unattachedDrawOffset>(0, 0, 0)</unattachedDrawOffset>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <fadeInTime>0</fadeInTime>
    <solidTime>.3</solidTime>
    <fadeOutTime>.35</fadeOutTime>
    <archHeight>0</archHeight>
    <growthRate>1</growthRate>
    <scalingAnchor>(.5, .5, 0)</scalingAnchor>
