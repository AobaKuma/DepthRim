  <!-- 中洋脊（2026-11-09，比照真實海底地形）：洋盆中線上隆起的海底火山山脈，比兩側的深海平原淺（約 2100–3500 m）。
       軸線上熱液旺盛的段落改成熱液噴口區（OceanBiomeSelector）。年輕的玄武岩地殼：用板岩代表深色火成岩；
       海底火山生態（Ocean_Volcanic.xml）：裸露的岩床 DR_RockFloor、海底火山 DR_UnderwaterVolcano、玄武岩塊 DR_Rock。 -->
  <BiomeDef ParentName="DepthRim_OceanBiomeBase">
    <defName>DepthRim_MidOceanRidge</defName>
    <label>mid-ocean ridge</label>
    <description>A volcanic mountain range running down the middle of the ocean basin, where new sea floor is born. The black rock is young and broken by rift valleys.</description>
    <texture>World/Biomes/DepthRim/MidOceanRidge</texture>
    <!-- 魚（Fish_Races.xml）：體型決定魚的生成比例，品種由水溫與生態區決定 -->
    <animalDensity>0.3</animalDensity>
    <wildAnimals>
      <DepthRim_Fish_Small>1</DepthRim_Fish_Small>
      <DepthRim_Fish_Medium>0.6</DepthRim_Fish_Medium>
      <DepthRim_Fish_Large>0.3</DepthRim_Fish_Large>
    </wildAnimals>
    <plantDensity>0</plantDensity>
    <forceRockTypes>
      <li>Slate</li>
    </forceRockTypes>
    <terrainsByFertility>
      <li>
        <terrain>DR_RockFloor</terrain>
        <min>-999</min>
        <max>0.6</max>
      </li>
      <li>
        <terrain>DepthRim_Seabed_Gravel</terrain>
        <min>0.6</min>
        <max>999</max>
      </li>
    </terrainsByFertility>
    <modExtensions>
      <li Class="DepthRim.WaterMapExtension">
        <depthTier>Deep</depthTier>
        <seafloorDepth>2100~3500</seafloorDepth>
        <hilliness>
          <li>Mountainous</li>
        </hilliness>
        <abyssBias>0.05</abyssBias>
        <!-- 海底火山生態：火山噴口與玄武岩塊（大的先放） -->
        <seafloorFeatures>
          <li>
            <thing>DR_UnderwaterVolcano</thing>
            <count>2~4</count>
          </li>
          <li>
            <thing>DR_Rock</thing>
