<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <BiomeDef Name="DepthRim_OceanBiomeBase" ParentName="Biome_Underground" Abstract="True">
    <workerClass>DepthRim.BiomeWorker_Ocean</workerClass>
    <generatesNaturally>false</generatesNaturally>
    <canAutoChoose>false</canAutoChoose>
    <canExitMap>false</canExitMap>
    <allowRoads>false</allowRoads>
    <allowRivers>false</allowRivers>
    <allowFarmingCamps>false</allowFarmingCamps>
    <hasVirtualPlants>false</hasVirtualPlants>
    <wildAnimalsCanWanderInto>false</wildAnimalsCanWanderInto>
    <noAmbientWind>true</noAmbientWind>
    <soundsAmbient>
      <li>DepthRim_Ambient_Shallow</li>
      <li>DepthRim_Ambient_Thermocline</li>
      <li>DepthRim_Ambient_Deep</li>
      <li>DepthRim_Ambient_Seabed</li>
      <li>DepthRim_HullInterior</li>
    </soundsAmbient>
    <hasBedrock>true</hasBedrock>
    <animalDensity>0</animalDensity>
    <maxFishPopulation>0</maxFishPopulation>
    <!-- 海底天氣（數值同原版地下天氣，只是名稱顯示「海底」） -->
    <baseWeatherCommonalities Inherit="False">
      <DepthRim_Undersea>1</DepthRim_Undersea>
    </baseWeatherCommonalities>
    <diseases Inherit="False" />
  </BiomeDef>

  <BiomeDef ParentName="DepthRim_OceanBiomeBase">
    <defName>DepthRim_PolarIceCap</defName>
    <label>subglacial ocean (shallows)</label>
    <description>A dark, cold ocean sealed under the frozen sea, shallow here over the continental shelf. Mineral-rich, and within reach of an ice shaft dug through the sea ice.</description>
    <texture>World/Biomes/DepthRim/PolarIceCap</texture>
    <!-- 魚（Fish_Races.xml）：體型決定魚的生成比例，品種由水溫與生態區決定 -->
    <animalDensity>0.6</animalDensity>
    <wildAnimals>
      <DepthRim_Fish_Small>1</DepthRim_Fish_Small>
      <DepthRim_Fish_Medium>0.6</DepthRim_Fish_Medium>
      <DepthRim_Fish_Large>0.3</DepthRim_Fish_Large>
    </wildAnimals>
    <plantDensity>0</plantDensity>
    <baseWeatherCommonalities Inherit="False">
      <DepthRim_UnderIce>1</DepthRim_UnderIce>
    </baseWeatherCommonalities>
    <forceRockTypes>
      <li>Granite</li>
      <li>Slate</li>
    </forceRockTypes>
    <terrainsByFertility>
      <li>
        <terrain>DepthRim_Seabed_Gravel</terrain>
        <min>-999</min>
        <max>0.45</max>
      </li>
      <li>
        <terrain>DepthRim_Seabed_Sand</terrain>
        <min>0.45</min>
        <max>999</max>
      </li>
    </terrainsByFertility>
    <modExtensions>
      <li Class="DepthRim.WaterMapExtension">
        <depthTier>Shallow</depthTier>
        <!-- 冷泉：升降井到得了的海域裡，海底研究點數的前期來源（Ocean_ColdSeep.xml） -->
        <seafloorFeatures>
          <li>
            <thing>DR_ColdSeep</thing>
            <count>2~3</count>
          </li>
        </seafloorFeatures>
        <seafloorDepth>3~200</seafloorDepth>
        <!-- 冰架下的深坑：升降井的地圖只有這裡，潛艇船塢（深淵上的船體平台）要有地方蓋 -->
        <abyssPockets>1~2</abyssPockets>
        <abyssPocketRadius>9~13</abyssPocketRadius>
        <hilliness>
          <li>LargeHills</li>
          <li>Mountainous</li>
        </hilliness>
      </li>
    </modExtensions>
  </BiomeDef>
