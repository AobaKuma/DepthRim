<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- 海底的「天氣」：沿用原版地下天氣的所有數值（無天空、無降水），只換名稱，右側讀數顯示「海底」而不是「地底」。 -->
  <WeatherDef ParentName="Weather_Underground">
    <defName>DepthRim_Undersea</defName>
    <label>undersea</label>
    <description>There is no weather on the sea floor, only the cold, dark water.</description>
  </WeatherDef>
  
  <WeatherDef ParentName="Weather_Underground">
    <defName>DepthRim_UnderIce</defName>
    <label>under the ice</label>
    <description>Sea ice seals the water overhead. Barely any daylight filters through; without lamps it is almost pitch dark.</description>
    <maxGlow>0.06</maxGlow>
    <skyColorsDay>
      <sky>(0.10, 0.13, 0.17)</sky>
      <shadow>(0.85, 0.85, 0.85)</shadow>
      <overlay>(0.35, 0.38, 0.42)</overlay>
      <saturation>0.8</saturation>
    </skyColorsDay>
    <skyColorsDusk>
      <sky>(0.10, 0.13, 0.17)</sky>
      <shadow>(0.85, 0.85, 0.85)</shadow>
      <overlay>(0.35, 0.38, 0.42)</overlay>
      <saturation>0.8</saturation>
    </skyColorsDusk>
    <skyColorsNightEdge>
      <sky>(0.10, 0.13, 0.17)</sky>
      <shadow>(0.85, 0.85, 0.85)</shadow>
      <overlay>(0.35, 0.38, 0.42)</overlay>
      <saturation>0.8</saturation>
    </skyColorsNightEdge>
    <skyColorsNightMid>
      <sky>(0.10, 0.13, 0.17)</sky>
      <shadow>(0.85, 0.85, 0.85)</shadow>
      <overlay>(0.35, 0.38, 0.42)</overlay>
      <saturation>0.8</saturation>
    </skyColorsNightMid>
  </WeatherDef>

</Defs>
